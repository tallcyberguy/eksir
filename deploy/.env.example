# EKSIR / ISOC — .env template
# Copy to `.env` and fill in real values. Never commit .env to git.
#
# Sections, in order:
#   1. Public-facing domain + TLS
#   2. Postgres
#   3. Redis
#   4. Qdrant (vector DB)
#   5. LiteLLM (LLM gateway) + provider keys
#   6. Auth (JWT, bootstrap admin)
#   7. Ingest (HMAC, email)
#   8. Threat intel API keys
#   9. Trend Micro Vision One (optional)
#   10. vLLM (optional self-hosted LLM)
#   11. Misc (logging, alerting, observability)

# ── 1. Public-facing ─────────────────────────────────────────────────────
# The public URL of the deployment. NOTE: the bundled config/Caddyfile serves
# plain HTTP on :80 (fine for local dev, or behind an external TLS terminator
# such as Cloudflare / a load balancer). To have Caddy terminate Let's Encrypt
# TLS directly, replace ":80" in config/Caddyfile with your domain and open
# 80+443. ISOC_DOMAIN is a label used by the app; it does not auto-enable TLS.
ISOC_DOMAIN=eksir.example.com
ISOC_PUBLIC_URL=https://eksir.example.com

# Container image source for the prod compose (docker-compose.prod.yml). A fork
# publishes images to its OWN GitHub owner via release.yml — set IMAGE_OWNER to
# your GitHub org/user, and EKSIR_VERSION to a pinned tag (never floating latest
# in production).
IMAGE_OWNER=tallcyberguy
EKSIR_VERSION=latest
# Deployment posture: dev | staging | prod. Set to "prod" (or "staging") for
# any exposed deployment: this makes the backend REFUSE to boot with a weak/
# default JWT_SECRET and restricts CORS to ISOC_PUBLIC_URL only (localhost
# origins are allowed in dev only). Leave unset/"dev" for local work.
ISOC_ENV=prod

# ── 2. Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=isoc
POSTGRES_PASSWORD=CHANGE-ME-strong-pw
POSTGRES_DB=isoc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Sync DATABASE_URL with the values above. Used by SQLAlchemy + ARQ.
DATABASE_URL=postgresql+asyncpg://isoc:CHANGE-ME-strong-pw@postgres:5432/isoc

# ── 3. Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 4. Qdrant ────────────────────────────────────────────────────────────
# Production: use the in-compose service (qdrant:6333).
# Dev on Mac: override with http://host.docker.internal:6333 to share the
# alert-memory-mcp Qdrant instance.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_ALERTS_COLLECTION=alerts_v2
QDRANT_KB_COLLECTION=knowledge_base_v2

# ── 5. LiteLLM gateway + provider keys ───────────────────────────────────
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=CHANGE-ME-litellm-master-key
LITELLM_DATABASE_URL=postgresql://isoc:CHANGE-ME-strong-pw@postgres:5432/litellm

# Provider keys — fill in the ones you actually use, leave others blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override the OpenAI-compatible base URL (e.g. for Azure / vLLM).
OPENAI_BASE_URL=

# Model routing — these are the VIRTUAL model names LiteLLM routes (see
# config/litellm.config.yaml). Do NOT put a raw provider model id here on the
# default LiteLLM path: the backend calls the proxy with these names, and the
# proxy maps isoc-deep -> claude-sonnet-4-5 / isoc-fast -> claude-haiku-4-5.
# To change the underlying model, edit config/litellm.config.yaml.
ISOC_MODEL_DEEP=isoc-deep
ISOC_MODEL_FAST=isoc-fast

# LLM cost governance (USD). When a cap is exceeded the deep synthesis call is
# skipped and the incident parks at awaiting_review for a human — it never auto-
# decides. 0 = disabled. Local/self-hosted models cost $0, so caps never fire on
# a local deployment. Enforced in the worker (reads this via env_file).
LLM_DAILY_COST_CAP_USD=0
LLM_INCIDENT_COST_CAP_USD=0

# ── 6. Auth ──────────────────────────────────────────────────────────────
# Generate fresh: `openssl rand -hex 64`. Rotating invalidates all sessions.
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720

# Bootstrap admin — created on first boot if no users exist. Change AFTER.
ISOC_BOOTSTRAP_ADMIN_EMAIL=admin@eksir.example.com
ISOC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-strong-bootstrap-pw

# ── 7. Ingest ────────────────────────────────────────────────────────────
# HMAC secret for webhook ingest signing. Per-source secrets are stored on
# the WebhookSource row; this is the fallback/global HMAC.
INGEST_HMAC_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32

# Pull ingestion master switch (scheduled console poll → RECEIVED incident).
# Sources are configured in Admin → Sources; this flag lets the cron actually
# run. Must be UPPERCASE here (compose substitutes it into the backend service).
PULL_INGEST_ENABLED=false

# Email ingest (planned; not yet wired). Leave disabled unless you've built it.
EMAIL_INGEST_ENABLED=false
EMAIL_INGEST_IMAP_HOST=
EMAIL_INGEST_IMAP_USER=
EMAIL_INGEST_IMAP_PASSWORD=
EMAIL_INGEST_POLL_INTERVAL_SECONDS=60

# ── 8. Threat intel ──────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=
IPINFO_TOKEN=

# ── 9. Trend Micro Vision One (optional) ─────────────────────────────────
V1_API_KEY=
V1_REGION=eu
V1_CUSTOMERS=
# Analyst-triggered live Endpoint Activity Data search for the Threat Hunter
# (manager chat → "run the hunt"). Default off. Requires the API key's
# "Agentic SIEM and XDR → XDR Data Explorer" role.
V1_ACTIVITY_SEARCH_ENABLED=false

# ── 9b. Microsoft Defender read tools (optional) ─────────────────────────
# Deep-tier LLM read tools during L2 synthesis: advanced hunting (Graph
# runHuntingQuery) + machine / file / IP detail (Defender for Endpoint API).
# Needs BOTH switches on AND a microsoft_defender connector row (admin →
# Connectors) for the customer, else the tools stay dark. Default off.
#   ISOC_ENABLE_LLM_TOOLS  = master switch for ALL deep-tier tools
#   DEFENDER_TOOLS_ENABLED = the Defender-specific gate
# Graph perms: ThreatHunting.Read.All (hunt); WindowsDefenderATP perms:
# Machine.Read.All / File.Read.All / Ip.Read.All (detail).
ISOC_ENABLE_LLM_TOOLS=false
DEFENDER_TOOLS_ENABLED=false
# Mirror the analyst verdict back to the Defender alert on approve (Graph
# SecurityAlert.ReadWrite.All). Outbound write, fail-soft. Default off.
DEFENDER_STATUS_WRITEBACK_ENABLED=false

# ── 9c. Multi-tenant credential isolation (recommended for many customers) ─
# When on, a NAMED customer must have its OWN EDR/XDR credential row — the shared
# 'default' row and the V1_API_KEY env fallback are refused, so an unmapped
# customer fails closed instead of borrowing another tenant's / a shared key.
# Leave OFF only for a single-tenant box relying on a global 'default'/env key.
STRICT_TENANT_CREDS=false

# ── 10. vLLM (optional self-hosted LLM) ──────────────────────────────────
VLLM_MODEL=
VLLM_QUANTIZATION=
VLLM_MAX_MODEL_LEN=
VLLM_GPU_MEMORY_UTILIZATION=

# ── 11. Misc ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SLACK_WEBHOOK_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Ollama endpoint for bge-m3 RAG embeddings (similar-case lookup). Ollama runs
# on the HOST, not in compose: install it and run `ollama pull bge-m3`. From a
# container, the host is host.docker.internal (NOT localhost, which is the
# container itself). Leave blank to DISABLE similar-case retrieval.
OLLAMA_URL=http://host.docker.internal:11434
