# Landing page configuration

# Where the "Sign in" / "Go to platform" buttons point.
NEXT_PUBLIC_APP_URL=https://platform.eksir.com

# Where demo requests are emailed.
DEMO_INBOX=hello@eksir.com

# SMTP — same env-var convention as the backend.
# If SMTP_HOST is unset the demo form returns 503 with a friendly message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eksir.com
SMTP_USE_TLS=true
