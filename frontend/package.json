{
  "name": "eksir-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":   "next dev -p 3000",
    "prebuild": "node -e \"const fs=require('fs');fs.existsSync('node_modules/tinymce')&&fs.cpSync('node_modules/tinymce','public/tinymce',{recursive:true})\"",
    "build": "next build",
    "start": "next start -p 3000",
    "lint":  "next lint",
    "type":  "tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs');fs.existsSync('node_modules/tinymce')&&fs.cpSync('node_modules/tinymce','public/tinymce',{recursive:true})\""
  },
  "dependencies": {
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.469.0",
    "clsx": "2.1.1",
    "tailwind-merge": "2.5.5",
    "class-variance-authority": "0.7.1",
    "recharts": "3.9.2",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.1",
    "zod": "3.24.1",
    "@tanstack/react-query": "5.101.2",
    "react-grid-layout": "1.5.2",
    "react-resizable": "4.0.2",
    "tinymce": "^7.6.0",
    "@tinymce/tinymce-react": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@types/react-grid-layout": "1.3.5",
    "@types/react-resizable": "4.0.0",
    "typescript": "5.7.2",
    "tailwindcss": "3.4.17",
    "@tailwindcss/typography": "0.5.20",
    "autoprefixer": "10.5.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.18"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
